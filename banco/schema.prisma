generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}


model Usuario {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  senha     String
  telefone  String?
  tipo      String

  createdAt DateTime @default(now())

  aluno        Aluno?
  professor    Professor?
  responsavel  Responsavel?

  mensagensEnviadas   Mensagem[] @relation("Remetente")
  mensagensRecebidas  Mensagem[] @relation("Destinatario")
}

// ALUNOS

model Aluno {
  id               Int      @id @default(autoincrement())
  matricula        String   @unique
  dataNascimento   DateTime?
  endereco         String?

  usuarioId        Int      @unique
  usuario          Usuario  @relation(fields: [usuarioId], references: [id])

  responsavelId    Int?
  responsavel      Responsavel? @relation(fields: [responsavelId], references: [id])

  matriculas       Matricula[]
  notas            Nota[]
  frequencias      Frequencia[]
  emprestimos      Emprestimo[]
}

// RESPONSÁVEIS

model Responsavel {
  id          Int      @id @default(autoincrement())

  usuarioId   Int      @unique
  usuario     Usuario  @relation(fields: [usuarioId], references: [id])

  alunos      Aluno[]
}

// PROFESSORES

model Professor {
  id              Int      @id @default(autoincrement())
  especialidade   String?

  usuarioId       Int      @unique
  usuario         Usuario  @relation(fields: [usuarioId], references: [id])

  disciplinas     Disciplina[]
}

// CURSOS

model Curso {
  id            Int      @id @default(autoincrement())
  nome          String
  descricao     String?

  disciplinas   Disciplina[]

  createdAt     DateTime @default(now())
}

// DISCIPLINAS

model Disciplina {
  id             Int      @id @default(autoincrement())
  nome           String
  cargaHoraria   Int

  cursoId        Int
  curso          Curso @relation(fields: [cursoId], references: [id])

  professorId    Int
  professor      Professor @relation(fields: [professorId], references: [id])

  matriculas     Matricula[]
  notas          Nota[]
  frequencias    Frequencia[]
}

// MATRÍCULAS

model Matricula {
  id              Int      @id @default(autoincrement())

  alunoId         Int
  aluno           Aluno @relation(fields: [alunoId], references: [id])

  disciplinaId    Int
  disciplina      Disciplina @relation(fields: [disciplinaId], references: [id])

  status          String   @default("ATIVA")

  createdAt       DateTime @default(now())

  @@unique([alunoId, disciplinaId])
}

// NOTAS  :)

model Nota {
  id              Int      @id @default(autoincrement())

  valor           Float
  bimestre        Int

  alunoId         Int
  aluno           Aluno @relation(fields: [alunoId], references: [id])

  disciplinaId    Int
  disciplina      Disciplina @relation(fields: [disciplinaId], references: [id])

  createdAt       DateTime @default(now())
}

// FREQUÊNCIA

model Frequencia {
  id              Int      @id @default(autoincrement())

  presente        Boolean
  data            DateTime

  alunoId         Int
  aluno           Aluno @relation(fields: [alunoId], references: [id])

  disciplinaId    Int
  disciplina      Disciplina @relation(fields: [disciplinaId], references: [id])
}

// MENSAGENS

model Mensagem {
  id               Int      @id @default(autoincrement())

  conteudo         String

  remetenteId      Int
  remetente        Usuario @relation("Remetente", fields: [remetenteId], references: [id])

  destinatarioId   Int
  destinatario     Usuario @relation("Destinatario", fields: [destinatarioId], references: [id])

  createdAt        DateTime @default(now())
}

// BIBLIOTECA

model Livro {
  id              Int      @id @default(autoincrement())

  titulo          String
  autor           String
  isbn            String   @unique
  quantidade      Int

  emprestimos     Emprestimo[]
}

// EMPRÉSTIMOS

model Emprestimo {
  id                Int      @id @default(autoincrement())

  livroId           Int
  livro             Livro @relation(fields: [livroId], references: [id])

  alunoId           Int
  aluno             Aluno @relation(fields: [alunoId], references: [id])

  dataEmprestimo    DateTime @default(now())
  dataDevolucao     DateTime?
}
